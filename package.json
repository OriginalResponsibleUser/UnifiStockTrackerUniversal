{
  "name": "unifi-stock-tracker-web",
  "version": "1.0.0",
  "description": "Web application for tracking Ubiquiti UniFi product stock",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install:all": "npm install && cd client && npm install",
    "audit:fix": "npm audit fix && cd client && npm audit fix"
  },
  "keywords": ["ubiquiti", "unifi", "stock", "tracker", "monitoring"],
  "author": "Stock Tracker Web",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.3",
    "cors": "^2.8.5",
    "axios": "^1.6.7",
    "socket.io": "^4.7.4",
    "node-cron": "^3.0.3",
    "sqlite3": "^5.1.7",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}